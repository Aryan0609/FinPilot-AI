# =========================
# FinPilot - Git Ignore
# =========================

# Environment / secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
target/

# Temporary / backup files
*.backup
*.bak
*~
*.tmp

# Database dumps
database/**/*_backup.sql
